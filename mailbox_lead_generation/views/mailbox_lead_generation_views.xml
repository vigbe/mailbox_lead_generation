<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST (not editable: inbox managed via buttons) -->
    <record id="mailbox_lead_generation_view_list" model="ir.ui.view">
        <field name="name">mailbox.lead.generation.list</field>
        <field name="model">mailbox.lead.generation</field>
        <field name="arch" type="xml">
            <tree string="Bandeja de correos">
                <field name="name"/>
                <field name="email_from"/>
                <field name="subject"/>
                <field name="lead_type" widget="badge"
                       decoration-success="lead_type == 'consulta'"
                       decoration-info="lead_type == 'captacion'"
                       decoration-muted="lead_type == 'sin_clasificar'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'nuevo'"
                       decoration-info="state == 'revisado'"
                       decoration-success="state == 'convertido'"
                       decoration-danger="state == 'rechazado_spam'"/>
                <field name="crm_lead_id" optional="hide"/>
                <field name="date_received"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="mailbox_lead_generation_view_form" model="ir.ui.view">
        <field name="name">mailbox.lead.generation.form</field>
        <field name="model">mailbox.lead.generation</field>
        <field name="arch" type="xml">
            <form string="Bandeja de correos">
                <header>
                    <button name="action_review" string="Revisar"
                            type="object" class="btn-secondary"
                            attrs="{&quot;invisible&quot;: [(&quot;state&quot;, &quot;!=&quot;, &quot;nuevo&quot;)]}"/>
                    <button name="action_convert_to_lead" string="Convertir en Lead"
                            type="object" class="btn-primary"
                            attrs="{&quot;invisible&quot;: [(&quot;state&quot;, &quot;not in&quot;, [&quot;nuevo&quot;, &quot;revisado&quot;])]}"/>
                    <button name="action_reject_spam" string="Rechazar spam"
                            type="object" class="btn-secondary"
                            attrs="{&quot;invisible&quot;: [(&quot;state&quot;, &quot;=&quot;, &quot;rechazado_spam&quot;)]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="nuevo,revisado,convertido"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_crm_lead" type="object"
                                class="oe_stat_button" icon="fa-arrow-up"
                                attrs="{&quot;invisible&quot;: [(&quot;crm_lead_id&quot;, &quot;=&quot;, False)]}">
                            <field name="crm_lead_id" widget="statinfo"
                                   string="Lead"/>
                        </button>
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="email_from"/>
                            <field name="email_to"/>
                            <field name="date_received"/>
                            <field name="subject"/>
                            <field name="message_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Clasificación">
                            <field name="lead_type"/>
                        </group>
                    </group>
                        <group string="Sugerencias de coincidencia">
                            <field name="suggestion_ids" nolabel="1" colspan="2" readonly="1">
                                <tree create="false" delete="false">
                                    <field name="match_type"/>
                                    <field name="record_ref"/>
                                    <field name="score"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'suggested'"
                                           decoration-success="state == 'accepted'"
                                           decoration-danger="state == 'rejected'"/>
                                    <field name="reason" optional="hide"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Contenido">
                            <field name="body_html" nolabel="1" colspan="2"/>
                        </group>
                    <group string="Salida">
                        <field name="crm_lead_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="mailbox_lead_generation_view_search" model="ir.ui.view">
        <field name="name">mailbox.lead.generation.search</field>
        <field name="model">mailbox.lead.generation</field>
        <field name="arch" type="xml">
            <search string="Bandeja de correos">
                <field name="name"/>
                <field name="subject"/>
                <field name="email_from"/>
                <separator/>
                <filter name="f_consulta" string="Consulta"
                        domain="[('lead_type', '=', 'consulta')]"/>
                <filter name="f_captacion" string="Captación"
                        domain="[('lead_type', '=', 'captacion')]"/>
                <filter name="f_sin_clasificar" string="Sin clasificar"
                        domain="[('lead_type', '=', 'sin_clasificar')]"/>
                <separator/>
                <filter name="f_nuevo" string="Nuevo"
                        domain="[('state', '=', 'nuevo')]"/>
                <filter name="f_revisado" string="Revisado"
                        domain="[('state', '=', 'revisado')]"/>
                <filter name="f_convertido" string="Convertido"
                        domain="[('state', '=', 'convertido')]"/>
                <filter name="f_spam" string="Spam"
                        domain="[('state', '=', 'rechazado_spam')]"/>
                <separator/>
                <filter name="g_lead_type" string="Agrupar por: Tipo"
                        context="{'group_by': 'lead_type'}"/>
                <filter name="g_state" string="Agrupar por: Estado"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="mailbox_lead_generation_action" model="ir.actions.act_window">
        <field name="name">Bandeja de correos</field>
        <field name="res_model">mailbox.lead.generation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay correos en la bandeja.
            </p>
            <p>
                Configure un servidor de correo entrante (fetchmail) con el
                modelo «mailbox.lead.generation» para que cada correo recibido cree un
                registro aquí, listo para clasificar y convertir en lead.
            </p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="mailbox_lead_generation_menu_root"
              name="Mail Box Lead Generation"
              sequence="40"/>

    <menuitem id="mailbox_lead_generation_menu_list"
              name="Bandeja de correos"
              parent="mailbox_lead_generation_menu_root"
              action="mailbox_lead_generation_action"
              sequence="10"/>
</odoo>
