<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_correos_leads" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.correos.leads</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 19: insert a dedicated app block before the first existing
                 app (base_setup general settings). Do not rely on legacy
                 div.settings, which no longer exists in the base settings form. -->
            <xpath expr="//app[1]" position="before">
                <app string="correos-leads" name="correos_leads"
                     data-key="correos_leads" groups="base.group_system">
                    <block title="Clasificación de correos"
                           id="correos_leads_classification_block">
                        <setting id="correos_email_consultas_setting"
                                 string="Emails de Consulta"
                                 help="Direcciones de destino (separadas por comas) que se clasifican como «consulta» (inquilino/comprador interesado).">
                            <field name="correos_email_consultas"
                                   placeholder="consultas@tudominio.com"/>
                        </setting>
                        <setting id="correos_email_captacion_setting"
                                 string="Emails de Captación"
                                 help="Direcciones de destino (separadas por comas) que se clasifican como «captación» (propietario ofreciendo una propiedad).">
                            <field name="correos_email_captacion"
                                   placeholder="captacion@tudominio.com"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
